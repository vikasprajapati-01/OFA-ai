# Copy to backend/.env and fill in your own values. Never commit the real file.
PORT=3000

# Neon (or any PostgreSQL) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk (backend needs both keys)
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key

# AI providers
GEMINI_API_KEY=your_gemini_key
CLIPDROP_API_KEY=your_clipdrop_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional
# RATE_LIMIT_PER_MIN=60                # per-user API limit (default 60)
# REDIS_URL=redis://localhost:6379     # turns on the history-list cache
# ENABLE_DB_HEALTH=true                # exposes GET /api/health/db (diagnostics only)
